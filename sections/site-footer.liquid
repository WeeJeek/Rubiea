<footer class="site-footer">
  <a class="site-header__brand" href="{{ routes.root_url }}">Rubiae</a>
  <nav class="site-footer__navigation" aria-label="{{ 'accessibility.footer_navigation' | t }}">
    <ul>
      {% for link in section.settings.menu.links %}
        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
      {% endfor %}
    </ul>
  </nav>
</footer>

{% schema %}
{
  "name": "Site footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu"
    }
  ]
}
{% endschema %}
