{% assign copy_key = section.settings.copy_key %}
{% assign prefix = 'editorial.' | append: copy_key %}

<article class="editorial-page editorial-page--{{ copy_key }}" aria-labelledby="EditorialPageTitle">
  <header class="editorial-page__intro">
    {% unless copy_key == 'privacy' or copy_key == 'cookies' or copy_key == 'not_found' %}
      <p class="home-eyebrow">{{ prefix | append: '.eyebrow' | t }}</p>
    {% endunless %}
    <h1 id="EditorialPageTitle">{{ prefix | append: '.heading' | t }}</h1>
    <p>{{ prefix | append: '.intro' | t: legal_name: section.settings.legal_name, domain: section.settings.domain }}</p>
  </header>

  {% case copy_key %}
    {% when 'stories' %}
      <p class="editorial-page__empty">{{ prefix | append: '.empty' | t }}</p>
    {% when 'how_to_choose' %}
      <ol class="editorial-page__steps">
        {% for number in (1..5) %}
          {% assign step_prefix = prefix | append: '.steps.' | append: number %}
          <li><h2>{{ step_prefix | append: '.heading' | t }}</h2><p>{{ step_prefix | append: '.body' | t }}</p></li>
        {% endfor %}
      </ol>
      <a class="home-button" href="{{ routes.root_url }}pages/stones">{{ prefix | append: '.cta' | t }}</a>
    {% when 'about' %}
      {% for paragraph in (1..3) %}
        <p>{{ prefix | append: '.paragraphs.' | append: paragraph | t }}</p>
      {% endfor %}
      <a class="home-text-link" href="{{ routes.root_url }}pages/contact">{{ prefix | append: '.cta' | t }}</a>
    {% when 'for_trade' %}
      <section aria-labelledby="TradeFocusTitle">
        <h2 id="TradeFocusTitle">{{ prefix | append: '.offer_heading' | t }}</h2>
        <ul>
          {% for item in (1..4) %}<li>{{ prefix | append: '.offer.' | append: item | t }}</li>{% endfor %}
        </ul>
      </section>
      <section aria-labelledby="TradeProcessTitle">
        <h2 id="TradeProcessTitle">{{ prefix | append: '.process_heading' | t }}</h2>
        <p>{{ prefix | append: '.process_body' | t }}</p>
      </section>
      <a class="home-button" href="{{ routes.root_url }}pages/contact?enquiry=trade">{{ prefix | append: '.cta' | t }}</a>
    {% when 'privacy' %}
      <section class="editorial-page__legal">
        {% for topic in 'data_collected,purpose,legal_basis,sharing,international,retention,rights' | split: ',' %}
          <h2>{{ prefix | append: '.' | append: topic | append: '_heading' | t }}</h2>
          <p>{{ prefix | append: '.' | append: topic | t }}</p>
        {% endfor %}
        <h2>{{ prefix | append: '.contact_heading' | t }}</h2>
        <p>{{ prefix | append: '.contact' | t: privacy_email: section.settings.privacy_email }}</p>
        {% if section.settings.processor_register != blank %}<div>{{ section.settings.processor_register | escape | newline_to_br }}</div>{% endif %}
        <p>{{ prefix | append: '.version' | t: version_date: section.settings.privacy_version_date }}</p>
      </section>
    {% when 'cookies' %}
      <section class="editorial-page__legal">
        <p>{{ prefix | append: '.choice' | t }}</p>
        <p>{{ prefix | append: '.change' | t }}</p>
        <h2>{{ prefix | append: '.inventory_heading' | t }}</h2>
        {% if section.settings.cookie_register != blank %}
          <div>{{ section.settings.cookie_register | escape | newline_to_br }}</div>
        {% else %}
          <p>{{ prefix | append: '.inventory_pending' | t }}</p>
        {% endif %}
        <p>{{ prefix | append: '.version' | t: version_date: section.settings.cookie_version_date }}</p>
      </section>
    {% when 'not_found' %}
      <a class="home-button" href="{{ routes.root_url }}pages/stones">{{ prefix | append: '.cta' | t }}</a>
  {% endcase %}
</article>

{% schema %}
{
  "name": "Editorial page",
  "settings": [
    { "type": "select", "id": "copy_key", "label": "Page copy", "options": [
      { "value": "stories", "label": "Stories" },
      { "value": "how_to_choose", "label": "How to choose" },
      { "value": "about", "label": "About" },
      { "value": "for_trade", "label": "For trade" },
      { "value": "privacy", "label": "Privacy" },
      { "value": "cookies", "label": "Cookies" },
      { "value": "not_found", "label": "404" }
    ], "default": "about" },
    { "type": "text", "id": "legal_name", "label": "Legal name" },
    { "type": "text", "id": "privacy_email", "label": "Privacy email" },
    { "type": "text", "id": "domain", "label": "Published domain" },
    { "type": "text", "id": "privacy_version_date", "label": "Privacy version date" },
    { "type": "textarea", "id": "processor_register", "label": "Current processor register" },
    { "type": "textarea", "id": "cookie_register", "label": "Cookie register" },
    { "type": "text", "id": "cookie_version_date", "label": "Cookie version date" }
  ]
}
{% endschema %}
